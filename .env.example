# Public site URL, used for canonical URLs, sitemap, OG tags, etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project — safe for the browser (publishable key is RLS-scoped)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — bypasses RLS. Never prefix with NEXT_PUBLIC_, never import
# outside src/lib/supabase/admin.ts and src/services/*.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by migration/type-generation
# tooling only (not by the app at runtime). URL-encode any special
# characters in the password.
SUPABASE_DB_URL=
